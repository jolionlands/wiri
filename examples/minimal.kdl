// Minimal wiri config — sane defaults for someone trying wiri for the first
// time. Drop into %APPDATA%\wiri\config.kdl; wiri reloads it when you save.
// The syntax is niri's (KDL): see resources/default_config.kdl for everything wiri reads.

version "1.0"

// `Mod` in a bind is Ctrl+Alt unless you say otherwise here.  Ctrl+Alt is the niri-inspired
// default and avoids the Win key reservations.
input {
    mod-key "ctrl-alt"
    // focus-follows-mouse
}

// wiri extension: keep wiri's built-in keymap.  Like niri, a `binds {}` block without
// `extend-defaults` binds only what is written in it.  Add your own binds in this block;
// one on the same keys as a built-in wins.
binds {
    extend-defaults
}

layout {
    // niri's one-number gaps: between windows and around the screen.
    gaps 12

    border {
        width 3
        inactive-color "#3c3836"
        active-color "#83a598"
    }

    // wiri's column sizing.
    column-width 700
    column-width-mode "proportional"

    snap-on-drag true
    snap-threshold-px 20
}

animations {
    on
    duration 180
    easing "ease-out-cubic"
    workspace-transition true
    focus-transition true
}
