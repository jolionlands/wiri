// Every wiri action bound to a memorable chord. Use this to learn the keymap;
// strip the binds you don't want once you've internalised them.
// The syntax is niri's (KDL): `Mod+Key { action; }`, with niri's bind properties.

version "1.0"

input {
    mod-key "Ctrl+Alt"
}

binds {
    // --- Navigation ---
    Mod+Left            { focus-column-left; }
    Mod+Right           { focus-column-right; }
    Mod+Up              { focus-window-up; }
    Mod+Down            { focus-window-down; }
    Mod+H               { scroll-left; }
    Mod+L               { scroll-right; }
    Mod+Grave           { focus-previous; }              // alt-tab MRU (Ctrl+Alt+Tab is Windows' own)

    // --- Move focused column ---
    Mod+Shift+Left      { move-column-left; }
    Mod+Shift+Right     { move-column-right; }
    Mod+Shift+Page_Up   { move-column-to-monitor-left; }
    Mod+Shift+Page_Down { move-column-to-monitor-right; }

    // --- Window state ---
    Mod+Q               { close-window; }
    Mod+F               { fullscreen-window; }
    Mod+T               { toggle-window-floating; }
    Mod+A               { toggle-always-on-top; }

    // --- Column rearrange (niri) ---
    Mod+Comma           { consume-window-into-column; }   // pull the right column's first window under this one
    Mod+Period          { expel-window-from-column; }     // bottom window gets a column of its own
    Mod+Shift+Bracket_Left   { consume-or-expel-window-left; }   // lone window joins the left column / one of several leaves to the left
    Mod+Shift+Bracket_Right  { consume-or-expel-window-right; }
    Mod+K               { move-window-up; }               // swap with the window above
    Mod+J               { move-window-down; }
    Mod+Home            { focus-column-first; }
    Mod+End             { focus-column-last; }
    Mod+Shift+Home      { move-column-to-first; }
    Mod+Shift+End       { move-column-to-last; }
    Mod+E               { expand-column-to-available-width; }   // fill remaining width
    Mod+Shift+F         { maximize-column; }              // column as wide as the view (toggle)

    // --- Keyboard resize ---
    Mod+Shift+L         { grow-column-width; }            // +5%
    Mod+Shift+H         { shrink-column-width; }          // -5%
    Mod+Shift+K         { grow-tile-height; }             // +5%
    Mod+Shift+J         { shrink-tile-height; }           // -5%

    // --- Column-width presets ---
    Mod+Bracket_Left    { set-column-width "33.333%"; }
    Mod+Bracket_Right   { set-column-width "66.667%"; }
    Mod+Backslash       { switch-preset-column-width; }

    // --- Workspaces ---
    Mod+1               { focus-workspace 1; }
    Mod+2               { focus-workspace 2; }
    Mod+3               { focus-workspace 3; }
    Mod+4               { focus-workspace 4; }
    Mod+5               { focus-workspace 5; }
    Mod+6               { focus-workspace 6; }
    Mod+7               { focus-workspace 7; }
    Mod+8               { focus-workspace 8; }
    Mod+9               { focus-workspace 9; }

    // --- Overview / multi-workspace view ---
    Mod+Space           { toggle-overview; }
    Mod+O               { overview-select; }
    // (Escape leaves the overview: the keyboard hook handles it, the key stays free for other programs.)

    // --- Capture ---
    Mod+P               { screenshot; }
    Mod+Shift+S         { screenshot-window; }

    // --- Spawn ---
    Mod+Return          hotkey-overlay-title="Terminal" { spawn "wt.exe"; }
    Mod+B               hotkey-overlay-title="Browser"  { spawn "msedge.exe"; }
    Mod+S               repeat=false { spawn-sh "start ."; }      // explorer in the current directory

    // --- Lifecycle ---
    Mod+Shift+Q         { quit; }
}

// --- Example window rules (niri syntax) ---
window-rule {
    match app-id="^CalcFrame"
    open-floating true
}
window-rule {
    match title="Picture-in-Picture"
    open-floating true
    open-focused false
}
