// vim: filetype=kdl
//
// wiri default configuration
// ───────────────────────────────────────────────────────────────────────────
// This is KDL, the syntax niri's config uses: a niri `binds {}` block, `window-rule`s, `include`
// and `spawn-at-startup` lines paste in as they are.  Copy this file to %APPDATA%\wiri\config.kdl
// and edit it.  wiri watches the file and reloads it a moment after you save; a mistake is reported
// in a balloon from the tray icon (file, line and column) and the last good config stays.
// `wiri-ctl validate-config` checks a file without loading it.
//
//   // ...        a comment            /- node       comments out one node or a whole section
//   r#"..."#      a raw string: no escapes, so Windows paths and regexes need no doubled backslashes
//
// A string that starts like a Windows path ("C:\Program Files\x") may keep its backslashes as they are.
//
// Reference: https://github.com/wiri-wm/wiri/blob/main/docs/SPEC.md
//

version "1.0"

// ───────────────────────────────────────────────────────────────────────────
// Input — keyboard, mouse, touch, focus policy
// ───────────────────────────────────────────────────────────────────────────
input {
    keyboard {
        repeat-delay 250        // ms before keyrepeat kicks in
        repeat-rate 25          // keys/sec while held
        // numlock              // turn NumLock on at startup
    }
    mouse {
        // natural-scroll      // invert the wheel direction (macOS-style) for wiri's own wheel binds
        scroll-speed 1.0        // multiplier on the system wheel delta
    }
    // touch {
    //     enable true
    //     tap-to-click true
    //     scroll-speed 1.0
    // }

    // niri: the window under the pointer gets the keyboard focus.  `focus-delay-ms` is wiri's own.
    // focus-follows-mouse
    // focus-delay-ms 150
    // warp-mouse-to-focus   // move the pointer to the middle of a window that was focused with the keyboard

    // niri: asking for the workspace you are on (focus-workspace 2 on the second one)
    // goes back to the previous workspace.
    // workspace-auto-back-and-forth

    // What `Mod` means in the binds below: "ctrl-alt" (the default), "alt", "ctrl", "super" (the Win key),
    // "win-alt" or "ctrl-shift".
    // mod-key "ctrl-alt"
}

// ───────────────────────────────────────────────────────────────────────────
// Layout — gaps, borders, focus ring, shadows, scrolling
// ───────────────────────────────────────────────────────────────────────────
layout {
    // niri writes one number (`gaps 16`) for the gap between windows and around the screen;
    // wiri can also tell them apart.
    gaps {
        inner 16                // between tiled windows
        outer 8                 // from the screen edge
    }
    // struts { left 0; right 0; top 0; bottom 0 }   // room kept free for a bar, in pixels

    border {
        width 4                 // 0 (or `off`) turns the border off
        inactive-color "#4d4d4d"
        active-color "#3381d9"
        urgent-color "#cc3344"  // windows that ask for attention
        // radius 8             // rounded corners (px); 0 = square
        // padding 0            // space between content and border
    }
    focus-ring {
        width 3                 // 0 (or `off`) turns the ring off
        active-color "#3381d9"
        // inactive-color "#404040"
        // gap 6                // gap between window edge and ring (px)
    }
    shadow {
        off                     // `on` lets DWM drop a soft shadow under tiled windows
        // softness 20          // niri's name for the blur radius
        // spread 0
        // offset x=0 y=5
        // color "#00000070"
    }

    // Column width mode: "proportional" (the columns share the screen) or
    // "fixed" (every column is exactly `column-width` pixels wide).
    column-width-mode "proportional"
    // In proportional mode the screen is shared by at most this many columns:
    // one window fills the screen, two get half each, three get a third each,
    // and from the fourth window on the columns stop shrinking and the strip
    // scrolls instead.  0 = no limit (columns shrink down to column-width / 2).
    max-visible-columns 3
    // Column width in pixels (the width in fixed mode; half of it is the
    // narrowest a proportional column may get).  Resize a single column with
    // the set-column-width / grow-column-width binds below.
    column-width 500
    // Pixels scrolled per scroll-left / scroll-right action.
    scroll-step 200
    // How the windows of the other workspaces are hidden: "hide" (the default;
    // they leave the taskbar and Alt+Tab) or "cloak" (the shell cloaks them: they
    // stay in the taskbar and Alt+Tab but are not drawn, and Alt+Tab to one brings
    // its workspace along).  Cloaking relies on undocumented shell interfaces: if
    // Windows does not offer them wiri logs that and hides the plain way.  If wiri
    // is killed while windows are cloaked, start it again and it shows them.
    // hide-method "cloak"

    // Dim unfocused windows (0.1-1.0, 1.0 = no dimming).  Dimming makes wiri
    // turn every managed window into a layered window, which some apps (Windows
    // Terminal, Chromium) do not like - opt in with e.g. 0.92.
    dim-unfocused 1.0

    // Strip native frame (caption + thick border) from tiled windows for
    // pixel-perfect tiles.  Default false — some apps (Windows Terminal,
    // Edge, some Electron) render their content area black after style
    // changes until they receive a fresh paint.  Off by default for
    // compatibility.
    // strip-frame true

    // Snap-on-drag: while you hold Alt and drag a tile with the left mouse button,
    // its left edge snaps to nearby column edges, the mid-screen guide and the
    // monitor edges.  A thin vertical line is painted at the snap target.
    // snap-on-drag true
    // snap-threshold-px 20

    // Smart borders: no border on a workspace that holds exactly one column with
    // exactly one tile.  Default false.
    // smart-borders true
}

// ───────────────────────────────────────────────────────────────────────────
// Animations
// ───────────────────────────────────────────────────────────────────────────
animations {
    off                         // `on` to animate; performance-conscious default
    duration 200                // ms
    easing "ease-out-cubic"     // none | linear | ease-in | ease-out | ease-in-out | cubic-out
}

// ───────────────────────────────────────────────────────────────────────────
// The "Important Hotkeys" sheet — niri's hotkey overlay.
//
// wiri shows it when it starts (any key press or click closes it) and the
// `show-hotkey-overlay` action opens it again.  Uncomment to change that:
//
// hotkey-overlay {
//     skip-at-startup     // do not open the sheet when wiri starts
//     hide-not-bound      // list only the hotkeys that are actually bound
// }
// ───────────────────────────────────────────────────────────────────────────
// Keybindings.  `Mod` is Ctrl+Alt unless `input { mod-key }` says otherwise.
//
// These binds are added to wiri's built-in defaults by the `extend-defaults` line in
// `binds {}` below (a bind here wins when it uses the same keys as a built-in one).
// `extend-defaults` is a wiri extension: like niri, a `binds {}` block without it counts
// alone, with no built-ins filled in.  Delete the line (or write `extend-defaults false`)
// and only the binds written in this block are active.
//
// A bind is a key combination and one action in braces; niri's properties are
// accepted: repeat=false (holding the key fires once), cooldown-ms=300,
// hotkey-overlay-title="...".  Comment a bind out with // or `/-` to unbind it.
// ───────────────────────────────────────────────────────────────────────────
binds {
    extend-defaults

    // Focus navigation
    Mod+Left   { focus-column-left; }
    Mod+Right  { focus-column-right; }
    Mod+Up     { focus-window-up; }
    Mod+Down   { focus-window-down; }

    // Move columns
    Mod+Shift+Left   { move-column-left; }
    Mod+Shift+Right  { move-column-right; }

    // Window actions
    Mod+Q { close-window; }
    // Open a terminal — prefers Windows Terminal (`wt.exe`), falling back to
    // PowerShell via the shell path so you are never dropped into a bare
    // cmd.exe prompt.  Change this line for another terminal (Alacritty, WezTerm,
    // Ghostty, ...): `Mod+Return { spawn "alacritty"; }`.
    Mod+Return hotkey-overlay-title="Open a Terminal" { spawn-sh "start wt.exe || start powershell.exe"; }
    Mod+F { fullscreen-window; }
    Mod+T { toggle-window-floating; }

    // Infinite scroll (scrolls the view; focus follows)
    Mod+H { scroll-left; }
    Mod+L { scroll-right; }

    // Column-width presets.  set-column-width takes niri's size argument: "50%", "+10%", "-10%"
    // (of the view), "1200", "+100" (pixels); switch-preset-column-width cycles a third, a half,
    // two thirds.
    Mod+Bracket_Left   { set-column-width "33.333%"; }
    Mod+Bracket_Right  { set-column-width "66.667%"; }
    Mod+Backslash      { switch-preset-column-width; }

    // Column rearrange and sizing
    //   Mod+Comma   consume-window-into-column: the first window of the column on the right
    //               moves under the focused window
    //   Mod+Period  expel-window-from-column: the bottom window of the focused column gets
    //               a column of its own on the right
    //   Mod+E       the column takes the width the others leave free
    //   Mod+Shift+F maximize-column: the column is as wide as the view (toggle; also for one window)
    //   Mod+M       maximize-window-to-edges: the window fills the work area (no gaps, no border)
    //               and keeps its place in its column (toggle).  Mod+F is fullscreen, which also
    //               hides the taskbar; the other windows are not hidden for either
    //   Mod+Shift+L / H  grow / shrink the column width by 5%
    //   Mod+Shift+K / J  grow / shrink the tile height by 5% (columns with several windows)
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }
    Mod+E            { expand-column-to-available-width; }
    Mod+Shift+F      { maximize-column; }
    Mod+M            { maximize-window-to-edges; }
    Mod+Shift+L      { grow-column-width; }
    Mod+Shift+H      { shrink-column-width; }
    Mod+Shift+K      { grow-tile-height; }
    Mod+Shift+J      { shrink-tile-height; }

    // niri keymap: columns and windows
    //   Mod+Home / End                    focus the first / last column
    //   Mod+Shift+Home / End              move the column to the start / end of the strip
    //   Mod+Shift+Bracket_Left / Right    consume-or-expel-window-left / right: a lone window
    //                                     joins the column on that side, one of several leaves
    //   Mod+K / J                         move-window-up / down inside the column
    Mod+Home                    { focus-column-first; }
    Mod+End                     { focus-column-last; }
    Mod+Shift+Home              { move-column-to-first; }
    Mod+Shift+End               { move-column-to-last; }
    Mod+Shift+Bracket_Left      { consume-or-expel-window-left; }
    Mod+Shift+Bracket_Right     { consume-or-expel-window-right; }
    Mod+K                       { move-window-up; }
    Mod+J                       { move-window-down; }

    // Workspaces and monitors
    //   Mod+Shift+Page_Up / Down    swap the workspace with the one above / below
    //   Mod+Shift+Up / Down         move the column to the workspace above / below
    //   Mod+Shift+Comma / Period    move the column to the monitor on the left / right
    Mod+Shift+Page_Up    { move-workspace-up; }
    Mod+Shift+Page_Down  { move-workspace-down; }
    Mod+Shift+Up         { move-column-to-workspace-up; }
    Mod+Shift+Down       { move-column-to-workspace-down; }
    Mod+Shift+Comma      { move-column-to-monitor-left; }
    Mod+Shift+Period     { move-column-to-monitor-right; }

    // Quit
    Mod+Shift+Q { quit; }

    // Workspaces: Mod+1 is the first workspace of the monitor, Mod+2 the second, ...
    // (focus-workspace "name" goes to a named workspace)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Overview (zoom out to see all columns across every workspace).
    //
    // NOTE: Ctrl+Alt+Tab is reserved by Windows for the system task switcher
    // (the accessibility cousin of Alt+Tab) — RegisterHotKey usually succeeds
    // but the OS still intercepts the chord, so the binding silently never
    // fires.  The default below uses Mod+Space and Escape instead.
    //
    // The bare Escape binding is state-gated: it only triggers an overview
    // toggle WHEN overview is active.  Outside overview, Escape stays
    // available for other applications.
    Mod+Space  { toggle-overview; }
    Escape     { toggle-overview; }
    Mod+O      { overview-select; }

    // Screenshot: capture the full virtual desktop to a BMP file under
    // %USERPROFILE%\Pictures\wiri-<timestamp>.bmp (falls back to the
    // current working directory if Pictures is not writable).
    Mod+P { screenshot; }

    // Window screenshot: capture only the focused window via
    // PrintWindow(hwnd, hdc, PW_RENDERFULLCONTENT).  The file lands under
    // %USERPROFILE%\Pictures\wiri-window-<hwnd>-<timestamp>.bmp.
    Mod+Shift+S { screenshot-window; }
}

// ───────────────────────────────────────────────────────────────────────────
// Programs to start with wiri.  One line per program, each argument its own string.
// ───────────────────────────────────────────────────────────────────────────
// spawn-at-startup "wt.exe"
// spawn-at-startup "explorer.exe" "shell:startup"
// spawn-sh-at-startup "start /min notepad.exe"

// ───────────────────────────────────────────────────────────────────────────
// Include other KDL files.  Paths are relative to this file, absolute, `~/...` or
// start with an environment variable (`%USERPROFILE%\...`).  An include is read
// where it stands: a later `binds` replaces earlier binds on the same keys.
// `optional=true` makes a missing file a warning instead of an error.
// ───────────────────────────────────────────────────────────────────────────
// include "binds.kdl"
// include optional=true "work.kdl"

// ───────────────────────────────────────────────────────────────────────────
// Output configuration — uncomment and adjust for your monitors.  The name is
// the Windows device name (`\\.\DISPLAY1`, see `wiri-ctl list-monitors`).
// ───────────────────────────────────────────────────────────────────────────
// output "Primary" {
//     scale 1.0
//     // off                      // niri: keep wiri off this monitor
//     // focus-at-startup
//     // variable-refresh-rate
//     // transform "normal"       // normal | 90 | 180 | 270
//     // position x=0 y=0
// }

// ───────────────────────────────────────────────────────────────────────────
// Named workspaces exist from the start, in the order declared, even when empty (niri's
// named workspaces); binds reach them with `focus-workspace "web"`.  `focus-workspace 2`
// is the second workspace from the top of the monitor.
// ───────────────────────────────────────────────────────────────────────────
// workspace "web"
// workspace "chat" {
//     open-on-output "Primary"
// }

// ───────────────────────────────────────────────────────────────────────────
// Window rules — niri's: a window matches a rule when it matches ANY of its `match`
// lines (the properties of one line must ALL hold) and none of its `exclude` lines.
//
//   app-id   a regular expression searched in the program's file name (`firefox.exe`, and
//            `firefox` without the extension) and, for Store apps, in the AppUserModelID
//   title    a regular expression searched in the window title
//   is-active / is-focused / is-floating / is-urgent / at-startup = true or false
//
// Properties: open-on-output, open-on-workspace "name", open-floating, open-fullscreen,
// open-maximized, open-focused, default-column-width { proportion 0.5; } (or { fixed 800; }),
// default-window-height, min-width, max-width, min-height, max-height, opacity.
// ───────────────────────────────────────────────────────────────────────────
// window-rule {
//     match app-id=r#"^firefox"# title="^Picture-in-Picture$"
//     open-floating true
//     open-focused false
// }
// window-rule {
//     match app-id=r#"^(steam|discord)"#
//     open-on-workspace "chat"
// }
// window-rule {
//     match app-id="^mspaint"
//     default-column-width { fixed 800; }
//     default-window-height { fixed 600; }
// }
// window-rule {
//     // Every window except terminals opens at 95% opacity.
//     exclude app-id=r#"^(WindowsTerminal|wt)"#
//     opacity 0.95
// }
