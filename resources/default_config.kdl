// vim: filetype=kdl
//
// wiri default configuration
// ───────────────────────────────────────────────────────────────────────────
// Copy this file to %APPDATA%\wiri\config.kdl and customise.  wiri watches
// the file and hot-reloads on save (~100 ms debounce); no restart needed.
//
// Reference: https://github.com/wiri-wm/wiri/blob/main/docs/SPEC.md
//

version "1.0"

// ───────────────────────────────────────────────────────────────────────────
// Input — keyboard, mouse, touch, focus policy
// ───────────────────────────────────────────────────────────────────────────
input {
    keyboard {
        layout "us"
        repeat-delay 250        // ms before keyrepeat kicks in
        repeat-rate 25          // keys/sec while held
        // numlock true         // turn NumLock on at startup
    }
    mouse {
        natural-scroll false    // true = invert wheel direction (macOS-style)
        scroll-speed 1.0        // multiplier on the system wheel delta
        acceleration 0.0        // advisory; Windows mouse accel is system-wide
        sensitivity 1.0
        tap-to-click false      // tap-to-click on touchpads
    }
    // touch {
    //     enable true
    //     tap-to-click true
    //     scroll-speed 1.0
    // }
    focus {
        follows-mouse false     // focus the window under the cursor automatically
        focus-delay-ms 150      // small delay so a fast pointer pass doesn't grab focus
        warp-on-focus false     // warp the cursor to the centre of the newly focused window
    }
    // niri: asking for the workspace you are on (focus-workspace 2 on the second one)
    // goes back to the previous workspace.
    // workspace-auto-back-and-forth
    // Modifier prefix for the default keybindings ("ctrl-alt", "alt",
    // "super" = Win key, "win-alt", "ctrl-shift").  Custom `binds {}`
    // blocks below override everything.
    // mod-key "ctrl-alt"
}

// ───────────────────────────────────────────────────────────────────────────
// Layout — gaps, borders, focus ring, shadows, scrolling
// ───────────────────────────────────────────────────────────────────────────
layout {
    gaps {
        inner 16                // gap between tiled windows
        outer 8                 // gap from the screen edge
    }
    borders {
        width 4                 // 0 disables borders entirely
        color "#4d4d4d"
        color-focused "#3381d9"
        color-urgent "#cc3344"  // colour for windows in the "urgent" state
        // radius 8             // rounded corner radius (px). 0 = square.
        // padding 0            // inner padding between content and border.
    }
    focus-ring {
        width 3                 // 0 disables the ring
        color "#3381d9"         // active ring colour
        // gap 6                // gap between window edge and ring (px)
        // inactive-color "#404040"
    }
    shadows {
        enable false            // DWM drops a soft drop-shadow on tiled windows
        // opacity 0.5
        // offset-x 10
        // offset-y 10
        // blur 20
        // spread 0
        // color "#000000"
    }

    // Column width mode: "proportional" (the columns share the screen) or
    // "fixed" (every column is exactly `column-width` pixels wide).
    column-width-mode "proportional"
    // In proportional mode the screen is shared by at most this many columns:
    // one window fills the screen, two get half each, three get a third each,
    // and from the fourth window on the columns stop shrinking and the strip
    // scrolls instead.  0 = no limit (columns shrink down to column-width / 2).
    max-visible-columns 3
    // Column width in pixels (the width in fixed mode; half of it is the
    // narrowest a proportional column may get).  Resize a single column with
    // the set-column-width / grow-column-width binds below.
    column-width 500
    // Pixels scrolled per scroll-left / scroll-right action.
    scroll-step 200
    // How the windows of the other workspaces are hidden: "hide" (the default;
    // they leave the taskbar and Alt+Tab) or "cloak" (the shell cloaks them: they
    // stay in the taskbar and Alt+Tab but are not drawn, and Alt+Tab to one brings
    // its workspace along).  Cloaking relies on undocumented shell interfaces: if
    // Windows does not offer them wiri logs that and hides the plain way.  If wiri
    // is killed while windows are cloaked, start it again and it shows them.
    // hide-method "cloak"

    // Dim unfocused windows (0.1-1.0, 1.0 = no dimming).  Dimming makes wiri
    // turn every managed window into a layered window, which some apps (Windows
    // Terminal, Chromium) do not like - opt in with e.g. 0.92.
    dim-unfocused 1.0

    // Strip native frame (caption + thick border) from tiled windows for
    // pixel-perfect tiles.  Default false — some apps (Windows Terminal,
    // Edge, some Electron) render their content area black after style
    // changes until they receive a fresh paint.  Off by default for
    // compatibility.
    // strip-frame true

    // Snap-on-drag (niri parity): while the user holds Alt and drags a
    // tile with the left mouse button, snap the window's left edge to
    // nearby column edges, the mid-screen guide, and the monitor edges.
    // A tiny vertical line is painted at the active snap target.
    // snap-on-drag true
    // snap-threshold-px 20

    // Smart borders (niri `borders { disable-when-only-one-window true }`
    // parity): when `true`, suppress the DWM border on workspaces that
    // contain exactly one column with exactly one tile.  Frees up usable
    // space when there's nothing to delimit.  Default false.
    // smart-borders true
    // The equivalent nested form also works:
    // borders { smart true }
}

// ───────────────────────────────────────────────────────────────────────────
// Animations
// ───────────────────────────────────────────────────────────────────────────
animations {
    enable false                // off by default; performance-conscious
    duration 200                // ms
    easing "ease-out-cubic"     // none | linear | ease-in | ease-out | ease-in-out | cubic-out
}

// ───────────────────────────────────────────────────────────────────────────
// Keybindings (Ctrl+Alt prefix by default)
//
// When any binds are defined, they REPLACE the defaults entirely.  Comment
// out a line to leave its key combo unbound.
// ───────────────────────────────────────────────────────────────────────────
binds {
    // Focus navigation
    Ctrl+Alt+Left   focus-column-left
    Ctrl+Alt+Right  focus-column-right
    Ctrl+Alt+Up     focus-up
    Ctrl+Alt+Down   focus-down

    // Move columns
    Ctrl+Alt+Shift+Left  move-column-left
    Ctrl+Alt+Shift+Right move-column-right

    // Window actions
    Ctrl+Alt+Q       close-window
    // Open a terminal — prefers Windows Terminal (`wt.exe`), falling back to
    // PowerShell via the shell path so the user is never dropped into a bare
    // cmd.exe prompt.  Override this line in your config if you want a
    // different terminal (Alacritty, WezTerm, Ghostty, etc.).
    Ctrl+Alt+Return  spawn-cmd "start wt.exe || start powershell.exe"
    Ctrl+Alt+F       toggle-fullscreen
    Ctrl+Alt+T       toggle-floating

    // Infinite scroll (scrolls the view; focus follows)
    Ctrl+Alt+H       scroll-left
    Ctrl+Alt+L       scroll-right

    // Column-width presets.  set-column-width takes niri's size argument too: "50%",
    // "+10%", "-10%" (of the view), "1200", "+100" (pixels); "cycle" is niri's
    // switch-preset-column-width (a third, a half, two thirds).
    Ctrl+Alt+Bracket_Left  set-column-width "1/3"
    Ctrl+Alt+Bracket_Right set-column-width "2/3"
    Ctrl+Alt+Backslash     set-column-width "cycle"

    // niri-parity: column-rearrange + size actions
    //   Ctrl+Alt+Comma   → consume-window-into-column: the first window of the
    //                      column on the right moves under the focused window
    //   Ctrl+Alt+Period  → expel-window-from-column: the bottom window of the
    //                      focused column gets a column of its own on the right
    //   Ctrl+Alt+E       → expand column to fill leftover work-area width
    //   Ctrl+Alt+Shift+F → maximize-column: the column is as wide as the view
    //                      (toggle; also for a column of one window)
    //   Ctrl+Alt+Shift+L → grow column width by 5%
    //   Ctrl+Alt+Shift+H → shrink column width by 5%
    //   Ctrl+Alt+Shift+K → grow tile height by 5% (multi-tile columns)
    //   Ctrl+Alt+Shift+J → shrink tile height by 5% (multi-tile columns)
    //   Ctrl+Alt+Shift+PageUp/PageDown → move column to monitor left/right
    Ctrl+Alt+Comma         consume-window-into-column
    Ctrl+Alt+Period        expel-window-from-column
    Ctrl+Alt+E             expand-column-to-available
    Ctrl+Alt+Shift+F       maximize-column
    Ctrl+Alt+Shift+L       grow-column-width
    Ctrl+Alt+Shift+H       shrink-column-width
    Ctrl+Alt+Shift+K       grow-tile-height
    Ctrl+Alt+Shift+J       shrink-tile-height

    // niri keymap: columns and windows
    //   Ctrl+Alt+Home / End               → focus the first / last column
    //   Ctrl+Alt+Shift+Home / End         → move the column to the start / end of the strip
    //   Ctrl+Alt+Shift+Bracket_Left/Right → consume-or-expel-window-left / right: a lone
    //                                       window joins the column on that side, one of
    //                                       several leaves its column on that side
    //   Ctrl+Alt+K / J                    → move-window-up / down inside the column
    Ctrl+Alt+Home                focus-column-first
    Ctrl+Alt+End                 focus-column-last
    Ctrl+Alt+Shift+Home          move-column-to-first
    Ctrl+Alt+Shift+End           move-column-to-last
    Ctrl+Alt+Shift+Bracket_Left  consume-or-expel-window-left
    Ctrl+Alt+Shift+Bracket_Right consume-or-expel-window-right
    Ctrl+Alt+K                   move-window-up
    Ctrl+Alt+J                   move-window-down

    // Workspace + column reorder (niri parity)
    //   Ctrl+Alt+Shift+Page_Up/Down → swap the focused workspace with the
    //                                 one above / below on the same monitor
    //   Ctrl+Alt+Shift+Up/Down      → move the focused column to the
    //                                 workspace above / below (creates dst
    //                                 workspace if missing)
    //   Ctrl+Alt+Shift+Comma/Period → move-column-to-monitor-left/right
    //                                 (relocated from Page_Up/Down so the
    //                                 Page_* chords match the niri default)
    Ctrl+Alt+Shift+Page_Up    move-workspace-up
    Ctrl+Alt+Shift+Page_Down  move-workspace-down
    Ctrl+Alt+Shift+Up         move-column-to-workspace-up
    Ctrl+Alt+Shift+Down       move-column-to-workspace-down
    Ctrl+Alt+Shift+Comma      move-column-to-monitor-left
    Ctrl+Alt+Shift+Period     move-column-to-monitor-right

    // Quit
    Ctrl+Alt+Shift+Q quit

    // Workspaces
    Ctrl+Alt+1 switch-workspace 1
    Ctrl+Alt+2 switch-workspace 2
    Ctrl+Alt+3 switch-workspace 3
    Ctrl+Alt+4 switch-workspace 4
    Ctrl+Alt+5 switch-workspace 5
    Ctrl+Alt+6 switch-workspace 6
    Ctrl+Alt+7 switch-workspace 7
    Ctrl+Alt+8 switch-workspace 8
    Ctrl+Alt+9 switch-workspace 9

    // Overview (zoom out to see all columns across every workspace).
    //
    // NOTE: Ctrl+Alt+Tab is reserved by Windows for the system task switcher
    // (the accessibility cousin of Alt+Tab) — RegisterHotKey usually succeeds
    // but the OS still intercepts the chord, so the binding silently never
    // fires.  The default below uses Ctrl+Alt+Space and Escape instead.
    //
    // The bare Escape binding is state-gated: it only triggers an overview
    // toggle WHEN overview is active.  Outside overview, Escape stays
    // available for other applications.
    Ctrl+Alt+Space overview-toggle
    Escape         overview-toggle
    Ctrl+Alt+O     overview-select

    // Screenshot: capture the full virtual desktop to a BMP file under
    // %USERPROFILE%\Pictures\wiri-<timestamp>.bmp (falls back to the
    // current working directory if Pictures is not writable).
    Ctrl+Alt+P   screenshot

    // Window-screenshot: capture only the focused window via
    // PrintWindow(hwnd, hdc, PW_RENDERFULLCONTENT).  Output file lands
    // under %USERPROFILE%\Pictures\wiri-window-<hwnd>-<timestamp>.bmp.
    Ctrl+Alt+Shift+S  window-screenshot
}

// ───────────────────────────────────────────────────────────────────────────
// Programs to launch on wiri startup.  One entry per `spawn-at-startup` line.
// Each argument is its own quoted token.
// ───────────────────────────────────────────────────────────────────────────
// spawn-at-startup "wt.exe"
// spawn-at-startup "explorer.exe" "shell:startup"

// ───────────────────────────────────────────────────────────────────────────
// Include other KDL files (niri parity).  Paths are resolved relative to
// this file (or absolute).  Cycles are detected and the nesting depth is
// capped at 8.  `include` directives are pre-processed before KDL parsing.
// ───────────────────────────────────────────────────────────────────────────
// include "binds.kdl"
// include "C:/Users/me/.config/wiri/window-rules.kdl"

// ───────────────────────────────────────────────────────────────────────────
// Shell-command shortcut (niri parity).  `spawn-cmd "<command>"` is the
// Windows equivalent of niri's `spawn-sh`; the dispatcher runs the argument
// through `cmd.exe /C "<command>"`.
// ───────────────────────────────────────────────────────────────────────────
// binds {
//     Ctrl+Alt+S spawn-cmd "wt.exe"
//     Ctrl+Alt+B spawn-cmd "start https://example.com"
// }

// ───────────────────────────────────────────────────────────────────────────
// Output configuration — uncomment and adjust for your monitors.
// `name` matches the friendly device name shown by Windows display settings.
// ───────────────────────────────────────────────────────────────────────────
// output "Primary" {
//     x 0
//     y 0
//     width 2560
//     height 1440
//     scale 1.0
//     enable true
//     // primary true
//     // vrr true                  // variable refresh rate
//     // transform "normal"        // normal | 90 | 180 | 270
// }

// ───────────────────────────────────────────────────────────────────────────
// Workspace configuration — uncomment to declare named workspaces.  They exist from
// the start, in the order declared, even when empty (niri's named workspaces), and
// binds reach them with `focus-workspace "Main"`.  `focus-workspace 2` is the second
// workspace from the top of the monitor.
// ───────────────────────────────────────────────────────────────────────────
// workspace "Main" {
//     layout "tile"
//     monitor "Primary"
//     follow-on-focus true
// }
// workspace "Comms" {
//     layout "tile"
//     monitor "Primary"
// }

// ───────────────────────────────────────────────────────────────────────────
// Window rules — pattern-match windows on creation and apply properties.
// Two styles are supported:
//
//   1. Flat fields (back-compat):
//        window-rule {
//            class-name "Firefox"
//            floating true
//        }
//
//   2. `match { }` block (regex + AND-combined matchers):
//        window-rule {
//            match {
//                class-name-regex "^(chrome|edge|firefox)$"
//                title-regex ".*Picture-in-Picture.*"
//            }
//            float true
//            sticky true
//        }
// ───────────────────────────────────────────────────────────────────────────
// window-rule {
//     class-name "Firefox"
//     floating true
// }
// window-rule {
//     class-name "mspaint"
//     default-width 800
//     default-height 600
//     opacity 1.0
// }
// window-rule {
//     match { process-name-regex "(?i)^(steam|discord)\.exe$" }
//     workspace "Comms"
//     sticky true
// }
// window-rule {
//     // Strip Windows-Terminal native title-bar so tiles are pixel-perfect.
//     class-name "CASCADIA_HOSTING_WINDOW_CLASS"
//     opacity 1.0
// }
//
// Blur backdrop (niri `blur { … }` parity) — request an Aero-style
// `DwmEnableBlurBehindWindow` backdrop for any window matching the rule.
// Best paired with `float true` so the blur sits over the desktop / lower
// tiles instead of over the apps you're working with.
// window-rule {
//     class-name "MyFloater"
//     float true
//     blur true
// }
